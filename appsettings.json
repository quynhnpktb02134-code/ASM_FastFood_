// ----------------------------------------------------------
// 6️⃣ 🟦 CLIENT API
// ----------------------------------------------------------
var clientApi = app.MapGroup("/api/client");

// Public client APIs
clientApi.MapGet("/categories", async (ApplicationDbContext db) =>
    await db.Categories.Select(c => new { c.Id, c.Name }).ToListAsync());

clientApi.MapGet("/foods", async (ApplicationDbContext db) =>
    await db.Foods.Select(f => new { f.Id, f.Name, f.Price, f.ImagePath, f.CategoryId }).ToListAsync()); // Thêm CategoryId

clientApi.MapGet("/combos", async (ApplicationDbContext db) =>
    await db.Combos.Select(c => new { c.Id, c.Name, c.Price, c.ImagePath }).ToListAsync());

// Client APIs that require authentication
var clientAuthApi = clientApi.RequireAuthorization();

const string CartSessionKey = "Cart";

#region Cart Management

// CART: Get current cart
clientAuthApi.MapGet("/cart", (HttpContext httpContext) =>
{
    var cartJson = httpContext.Session.GetString(CartSessionKey);
    var cart = cartJson is null ? new List<CartItem>() : JsonSerializer.Deserialize<List<CartItem>>(cartJson);
    return Results.Ok(cart);
});

// CART: Add or update cart item
clientAuthApi.MapPost("/cart", async (CartUpdateDto dto, ApplicationDbContext db, HttpContext httpContext) =>
{
    var session = httpContext.Session;
    var cartJson = session.GetString(CartSessionKey);
    var cart = cartJson is null ? new List<CartItem>() : JsonSerializer.Deserialize<List<CartItem>>(cartJson);

    var item = cart.FirstOrDefault(i => i.Id == dto.Id && i.IsCombo == dto.IsCombo);

    // Bổ sung: Lấy thông tin thực tế từ DB
    string itemName;
    decimal itemPrice;

    if (dto.IsCombo)
    {
        var combo = await db.Combos.FindAsync(dto.Id);
        if (combo is null) return Results.NotFound("Combo not found.");
        itemName = combo.Name;
        itemPrice = combo.Price;
    }
    else
    {
        var food = await db.Foods.FindAsync(dto.Id);
        if (food is null) return Results.NotFound("Food not found.");
        itemName = food.Name;
        itemPrice = food.Price;
    }

    if (item != null)
    {
        item.Quantity = dto.Quantity;
        // Cập nhật lại giá và tên (trường hợp giá hoặc tên đã thay đổi trong DB)
        item.Name = itemName;
        item.UnitPrice = itemPrice;
    }
    else if (dto.Quantity > 0)
    {
        cart.Add(new CartItem
        {
            Id = dto.Id,
            IsCombo = dto.IsCombo,
            Quantity = dto.Quantity,
            Name = itemName, // Lấy tên từ DB
            UnitPrice = itemPrice // Lấy giá từ DB
        });
    }

    // Loại bỏ các mục có Quantity <= 0
    cart.RemoveAll(i => i.Quantity <= 0);

    session.SetString(CartSessionKey, JsonSerializer.Serialize(cart));
    return Results.Ok(cart);
});

// CART: Remove item from cart (Giữ nguyên logic cũ vì nó đơn giản và đúng)
clientAuthApi.MapDelete("/cart/{id:int}/{isCombo:bool}", (int id, bool isCombo, HttpContext httpContext) =>
{
    var session = httpContext.Session;
    var cartJson = session.GetString(CartSessionKey);
    var cart = cartJson is null ? new List<CartItem>() : JsonSerializer.Deserialize<List<CartItem>>(cartJson);

    cart.RemoveAll(i => i.Id == id && i.IsCombo == isCombo);

    session.SetString(CartSessionKey, JsonSerializer.Serialize(cart));
    return Results.NoContent();
});

#endregion

#region Order Management

// ORDER: Create new order from cart (Logic đã được fix để tính Total chính xác hơn)
clientAuthApi.MapPost("/orders", async (ApplicationDbContext db, HttpContext http) =>
{
    var userId = http.User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (string.IsNullOrEmpty(userId)) return Results.Unauthorized();

    var cartJson = http.Session.GetString(CartSessionKey);
    var cart = cartJson is null ? new List<CartItem>() : JsonSerializer.Deserialize<List<CartItem>>(cartJson);

    if (!cart.Any()) return Results.BadRequest("Cart empty.");

    // Logic tính tổng sẽ sử dụng UnitPrice đã được lưu trong CartItem (đã lấy từ DB ở bước thêm/cập nhật giỏ hàng)
    var total = cart.Sum(i => i.Quantity * i.UnitPrice);

    var order = new Order
    {
        UserId = userId,
        OrderDate = DateTime.Now,
        Status = "Pending",
        Total = total,
        Items = cart.Where(i => !i.IsCombo)
                    .Select(i => new OrderItem { FoodId = i.Id, Quantity = i.Quantity, UnitPrice = i.UnitPrice })
                    .ToList(),
        Combos = cart.Where(i => i.IsCombo)
                     .Select(i => new OrderCombo { ComboId = i.Id, Quantity = i.Quantity, UnitPrice = i.UnitPrice })
                     .ToList()
    };

    db.Orders.Add(order);
    await db.SaveChangesAsync();

    // Xóa giỏ hàng sau khi tạo đơn hàng thành công
    http.Session.Remove(CartSessionKey);

    return Results.Created($"/api/client/orders/{order.Id}", order);
});

// ORDER: Get current user's orders (Giữ nguyên logic cũ)
clientAuthApi.MapGet("/orders/my", async (ApplicationDbContext db, HttpContext http) =>
{
    var userId = http.User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (string.IsNullOrEmpty(userId)) return Results.Unauthorized();

    var orders = await db.Orders
        .Where(o => o.UserId == userId)
        .OrderByDescending(o => o.OrderDate)
        .ToListAsync();

    return Results.Ok(orders);
});

#endregion

// ----------------------------------------------------------
// 7️⃣ MVC DEFAULT ROUTE
// ----------------------------------------------------------
app.MapControllerRoute(
    name: "default",
    pattern: "{controller=Home}/{action=Index}/{id?}");

app.Run();



// ----------------------------------------------------------
// 4️⃣ DTO DEFINITIONS & EXAMPLES
// ----------------------------------------------------------

/// <summary>
/// DTO cho Category.
/// Ví dụ: { "Name": "Burger" }
/// </summary>
public record CategoryDto(string Name);

/// <summary>
/// DTO cho Food.
/// Ví dụ: { "Name": "Gà rán", "Price": 35000, "ImagePath": "/images/ga.jpg", "Description": "Gà giòn tan", "CategoryId": 1 }
/// </summary>
public record FoodDto(string Name, decimal Price, string ImagePath, string Description, int CategoryId);

/// <summary>
/// DTO cho Combo.
/// Ví dụ: { "Name": "Combo Hạnh Phúc", "Price": 89000, "ImagePath": "/images/combo.jpg", "Description": "1 Gà + 1 Pepsi" }
/// </summary>
public record ComboDto(string Name, decimal Price, string ImagePath, string Description);

/// <summary>
/// DTO để cập nhật trạng thái đơn hàng.
/// Ví dụ: { "Status": "Delivering" }
/// </summary>
public record OrderStatusDto(string Status);

/// <summary>
/// DTO để thêm/cập nhật giỏ hàng.
/// Ví dụ: { "Id": 1, "IsCombo": false, "Quantity": 2 }
/// </summary>
public record CartUpdateDto(int Id, bool IsCombo, int Quantity);

