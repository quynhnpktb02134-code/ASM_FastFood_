using ASM_FastFood.Data;
using ASM_FastFood.Models;
using Microsoft.AspNetCore.Identity;
using Microsoft.EntityFrameworkCore;
using Microsoft.OpenApi.Models;
using System.Security.Claims;
using System.Text.Json;

var builder = WebApplication.CreateBuilder(args);

// ----------------------------------------------------------
// 1️⃣ SERVICE CONFIGURATION
// ----------------------------------------------------------

// Database Connection
builder.Services.AddDbContext<ApplicationDbContext>(options =>
    options.UseSqlServer(builder.Configuration.GetConnectionString("DefaultConnection")));

// Identity Setup
builder.Services.AddIdentity<ApplicationUser, IdentityRole>(options =>
{
    options.Password.RequireDigit = true;
    options.Password.RequireUppercase = false;
    options.Password.RequiredLength = 6;
})
.AddEntityFrameworkStores<ApplicationDbContext>()
.AddDefaultTokenProviders();

// Authorization Policy
builder.Services.AddAuthorization(options =>
{
    options.AddPolicy("AdminPolicy", policy => policy.RequireRole("Admin"));
});

// Cookie Configuration
builder.Services.ConfigureApplicationCookie(options =>
{
    options.LoginPath = "/Account/Login";
    options.AccessDeniedPath = "/Account/AccessDenied";
});

// MVC Controllers (For traditional Views/Controllers)
builder.Services.AddControllersWithViews();

// Swagger/OpenAPI
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen(c =>
{
    c.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "ASM FastFood API",
        Version = "v1"
    });
});

// Session Setup
builder.Services.AddDistributedMemoryCache();
builder.Services.AddSession(o => o.IdleTimeout = TimeSpan.FromMinutes(30));

var app = builder.Build();

// ----------------------------------------------------------
// 2️⃣ INITIALIZATION & SEEDING
// ----------------------------------------------------------
using (var scope = app.Services.CreateScope())
{
    var services = scope.ServiceProvider;
    var userMgr = services.GetRequiredService<UserManager<ApplicationUser>>();
    var roleMgr = services.GetRequiredService<RoleManager<IdentityRole>>();
    var db = services.GetRequiredService<ApplicationDbContext>();

    // Apply migrations
    db.Database.Migrate();
    // Seed data
    await SeedData.InitializeAsync(userMgr, roleMgr, db);
}

// ----------------------------------------------------------
// 3️⃣ MIDDLEWARE PIPELINE
// ----------------------------------------------------------

// Production error handling
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Home/Error");
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseStaticFiles();

app.UseRouting();

app.UseAuthentication();
app.UseAuthorization();

app.UseSession();

// Swagger Middleware
app.UseSwagger();
app.UseSwaggerUI(c =>
    c.SwaggerEndpoint("/swagger/v1/swagger.json", "ASM FastFood API v1"));

// Restrict Swagger Access to Admin Only
app.Use(async (context, next) =>
{
    if (context.Request.Path.StartsWithSegments("/swagger"))
    {
        // Check for authentication
        if (!context.User.Identity?.IsAuthenticated ?? true)
        {
            context.Response.Redirect("/Account/Login");
            return;
        }
        // Check for Admin role
        if (!context.User.IsInRole("Admin"))
        {
            context.Response.StatusCode = 403;
            await context.Response.WriteAsync("403 - Forbidden: Only Admin can access Swagger.");
            return;
        }
    }
    await next();
});



// ----------------------------------------------------------
// 5️⃣ 🟩 ADMIN API (Requires AdminPolicy Authorization)
// ----------------------------------------------------------
var adminApi = app.MapGroup("/api/admin").RequireAuthorization("AdminPolicy");

#region Category Management

// CATEGORY CRUD
adminApi.MapGet("/categories", async (ApplicationDbContext db) =>
    await db.Categories.ToListAsync());

adminApi.MapPost("/categories", async (CategoryDto dto, ApplicationDbContext db) =>
{
    var category = new Category { Name = dto.Name };
    db.Categories.Add(category);
    await db.SaveChangesAsync();
    return Results.Created($"/api/admin/categories/{category.Id}", category);
});

adminApi.MapPut("/categories/{id}", async (int id, CategoryDto dto, ApplicationDbContext db) =>
{
    var category = await db.Categories.FindAsync(id);
    if (category is null) return Results.NotFound();
    category.Name = dto.Name;
    await db.SaveChangesAsync();
    return Results.NoContent();
});

adminApi.MapDelete("/categories/{id}", async (int id, ApplicationDbContext db) =>
{
    var category = await db.Categories.FindAsync(id);
    if (category is null) return Results.NotFound();
    db.Categories.Remove(category);
    await db.SaveChangesAsync();
    return Results.NoContent();
});

#endregion

